<!-- Level restrictions for activities -->
<TABLE NAME="local_pb_restrictions" COMMENT="Level restrictions for course activities">
  <FIELDS>
    <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
    <FIELD NAME="cmid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
    <FIELD NAME="restricted_level" TYPE="int" LENGTH="5" NOTNULL="true" DEFAULT="1"/>
    <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
  </FIELDS>
  <KEYS>
    <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
    <KEY NAME="cmid" TYPE="unique" FIELDS="cmid"/>
  </KEYS>
</TABLE>
<!-- Coupons table -->
<TABLE NAME="local_pb_coupons" COMMENT="Coupons generated by users">
  <FIELDS>
    <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
    <FIELD NAME="code" TYPE="char" LENGTH="50" NOTNULL="true"/>
    <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
    <FIELD NAME="type" TYPE="char" LENGTH="50" NOTNULL="true"/>
    <FIELD NAME="xp_cost" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
    <FIELD NAME="used" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0"/>
    <FIELD NAME="used_by" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
    <FIELD NAME="used_at" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
    <FIELD NAME="created_at" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
    <FIELD NAME="expires_at" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
  </FIELDS>
  <KEYS>
    <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
    <KEY NAME="code" TYPE="unique" FIELDS="code"/>
  </KEYS>
</TABLE>
<!-- Premium activity restrictions -->
<TABLE NAME="local_pb_premium_restrictions" COMMENT="Activities marked as premium content that require unlock">
  <FIELDS>
    <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
    <FIELD NAME="cmid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
    <FIELD NAME="is_premium" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="1"/>
    <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
  </FIELDS>
  <KEYS>
    <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
    <KEY NAME="cmid" TYPE="unique" FIELDS="cmid"/>
  </KEYS>
</TABLE>

<!-- VIP activity restrictions -->
<TABLE NAME="local_pb_vip_restrictions" COMMENT="VIP-only activities that require special access">
  <FIELDS>
    <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
    <FIELD NAME="cmid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
    <FIELD NAME="is_vip_only" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="1"/>
    <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
    <FIELD NAME="early_access_days" TYPE="int" LENGTH="5" NOTNULL="true" DEFAULT="7"/>
  </FIELDS>
  <KEYS>
    <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
    <KEY NAME="cmid" TYPE="unique" FIELDS="cmid"/>
  </KEYS>
</TABLE>

<!-- Track unlocked activities for users -->
<TABLE NAME="local_pb_unlocked_activities" COMMENT="Tracks which activities users have unlocked">
  <FIELDS>
    <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
    <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
    <FIELD NAME="cmid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
    <FIELD NAME="unlocked_at" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
    <FIELD NAME="is_vip" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0"/>
  </FIELDS>
  <KEYS>
    <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
    <KEY NAME="user_cm" TYPE="unique" FIELDS="userid, cmid"/>
    <KEY NAME="userid" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
  </KEYS>
</TABLE>
<!-- Extra quiz attempts -->
<TABLE NAME="local_pb_extra_attempts" COMMENT="Extra quiz attempts purchased with XP">
  <FIELDS>
    <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
    <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
    <FIELD NAME="quizid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
    <FIELD NAME="extra_attempts" TYPE="int" LENGTH="5" NOTNULL="true" DEFAULT="0"/>
    <FIELD NAME="used_attempts" TYPE="int" LENGTH="5" NOTNULL="true" DEFAULT="0"/>
  </FIELDS>
  <KEYS>
    <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
    <KEY NAME="user_quiz" TYPE="unique" FIELDS="userid, quizid"/>
  </KEYS>
</TABLE>
</XMLDB>