{{!
    @template theme_mytheme/navbar

    Custom navbar override for mytheme
}}
{{#isloggedin}}
<nav class="navbar fixed-top navbar-expand-lg navbar-light bg-white shadow-sm" aria-label="{{#str}}sitemenubar, admin{{/str}}">
    <div class="container-fluid px-2 px-md-3">
        <!-- LEFT TOGGLE - Mobile menu button -->
        <button class="navbar-toggler d-lg-none ms-0 me-2 border-0" 
                type="button" 
                id="mobileMenuToggle"
                aria-label="Toggle navigation menu">
            <span class="navbar-toggler-icon"></span>
        </button>

        <!-- Logo/Brand -->
        <a href="{{{ config.wwwroot }}}/index.php?redirect=0" class="navbar-brand d-none d-lg-flex align-items-center m-0 p-0 me-2 me-md-3" aria-label="{{{ sitename }}}">
            {{#logo_url}}
                <img src="{{{logo_url}}}" class="logo me-2" alt="{{sitename}}" height="35" width="auto">
            {{/logo_url}}
            {{^logo_url}}
                {{#output.should_display_navbar_logo}}
                    <img src="{{output.get_compact_logo_url}}" class="logo me-2" alt="{{sitename}}" height="35" width="auto">
                {{/output.should_display_navbar_logo}}
                {{^output.should_display_navbar_logo}}
                    <span class="site-name fw-bold text-primary d-none d-sm-inline">{{{ sitename }}}</span>
                {{/output.should_display_navbar_logo}}
            {{/logo_url}}
        </a>

        <!-- RIGHT TOGGLE - Profile dropdown button (Mobile only) -->
        <div class="dropdown ms-auto d-lg-none">
            <button class="btn btn-link text-dark text-decoration-none p-0 border-0 bg-transparent" 
                    type="button" 
                    id="mobileProfileToggle" 
                    aria-expanded="false">
