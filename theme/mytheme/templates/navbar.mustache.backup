<style>
/* CSS to hide the text label on the edit mode toggle button globally within our containers */
.edit-mode-button-only button,
.edit-mode-button-only .btn,
.edit-mode-container .btn {
    white-space: nowrap;
}

/* Hide internal "Edit mode" text instantly without breaking the switch UI */
.edit-mode-button-only label, 
.edit-mode-container label,
.edit-mode-button-only .form-check-label,
.edit-mode-container .form-check-label {
    width: 35px !important;
    overflow: hidden !important;
    white-space: nowrap !important;
    text-indent: 100px !important; /* Push text out of view */
    margin-bottom: 0 !important;
    padding-left: 0 !important;
}

.edit-mode-button-only .btn span:not(.icon),
.edit-mode-container .btn span:not(.icon) {
    display: none !important;
}

.edit-mode-button-only .btn .icon,
.edit-mode-container .btn .icon {
    margin-right: 0 !important;
}

/* Keep the icon visible and adjust spacing */
.edit-mode-button-only .btn i,
.edit-mode-button-only .btn .fa,
.edit-mode-container .btn i,
.edit-mode-container .btn .fa {
    margin-right: 0 !important;
}
</style>

{{#js}}
require(['jquery', 'core/ajax', 'core/notification', 'core/str'], function($, Ajax, Notification, Str) {
    
    // ===== MOBILE PROFILE DROPDOWN - FIXED POSITIONING =====
    function initMobileProfileDropdown() {
        var mobileBtn = document.getElementById('mobileProfileToggle');
        var mobileMenu = document.getElementById('mobileProfileMenu');

        if (!mobileBtn || !mobileMenu) {
            return;
        }

        // Remove old event listeners by cloning
        var newBtn = mobileBtn.cloneNode(true);
        mobileBtn.parentNode.replaceChild(newBtn, mobileBtn);
        mobileBtn = newBtn;
        mobileMenu = document.getElementById('mobileProfileMenu');

        // Position the dropdown properly
        function positionDropdown() {
            if (window.innerWidth < 992) {
                mobileMenu.style.position = 'fixed';
                mobileMenu.style.top = '60px';
                mobileMenu.style.right = '10px';
                mobileMenu.style.left = 'auto';
                mobileMenu.style.transform = 'none';
                mobileMenu.style.width = '280px';
                mobileMenu.style.maxWidth = 'calc(100vw - 20px)';
                mobileMenu.style.zIndex = '9999';
                mobileMenu.style.borderRadius = '12px';
                mobileMenu.style.boxShadow = '0 8px 30px rgba(0, 0, 0, 0.2)';
            }
        }

        // Initial positioning
        positionDropdown();

        // Reposition on resize
        window.addEventListener('resize', positionDropdown);

        mobileBtn.addEventListener('click', function(e) {
            e.preventDefault();
            e.stopPropagation();

            // Reposition before showing
            positionDropdown();

            if (mobileMenu.classList.contains('show')) {
                mobileMenu.classList.remove('show');
                mobileBtn.setAttribute('aria-expanded', 'false');
            } else {
                // Close all other dropdowns first
                document.querySelectorAll('.dropdown-menu').forEach(function(menu) {
                    menu.classList.remove('show');
                });
                document.querySelectorAll('.navbar .dropdown-toggle').forEach(function(toggle) {
                    toggle.setAttribute('aria-expanded', 'false');
                });
                
                mobileMenu.classList.add('show');
                mobileBtn.setAttribute('aria-expanded', 'true');
            }
        });

        // Close when clicking outside
        $(document).off('click.mythemeMobileProfile').on('click.mythemeMobileProfile', function(e) {
            var btn = document.getElementById('mobileProfileToggle');
            var menu = document.getElementById('mobileProfileMenu');
            if (!btn || !menu || !menu.classList.contains('show')) {
                return;
            }
            if (!btn.contains(e.target) && !menu.contains(e.target)) {
                menu.classList.remove('show');
                btn.setAttribute('aria-expanded', 'false');
            }
        });

        // Close on Escape key
        $(document).off('keydown.mythemeMobileProfile').on('keydown.mythemeMobileProfile', function(e) {
            if (e.key !== 'Escape') {
                return;
            }
            var btn = document.getElementById('mobileProfileToggle');
            var menu = document.getElementById('mobileProfileMenu');
            if (menu && menu.classList.contains('show')) {
                menu.classList.remove('show');
                if (btn) {
                    btn.setAttribute('aria-expanded', 'false');
                }
            }
        });
    }

    // ===== CLICK OUTSIDE / ESCAPE HANDLER FOR ALL DROPDOWNS =====
    function initGlobalDropdownClosers() {
        $(document).on('click.mythemeGlobal', function(e) {
            // Close desktop user menu if clicking outside
            var userMenu = $('#userMenuDropdown').parent();
            if (userMenu.length && !userMenu[0].contains(e.target)) {
                userMenu.find('.dropdown-menu').removeClass('show');
                userMenu.find('.dropdown-toggle').attr('aria-expanded', 'false');
                userMenu.find('.dropdown-arrow-icon').css('transform', 'rotate(0deg)');
            }
            
            // Close notification dropdown if clicking outside
            var notificationsMenu = $('#notificationsBell').parent();
            if (notificationsMenu.length && !notificationsMenu[0].contains(e.target)) {
                notificationsMenu.find('.dropdown-menu').removeClass('show');
                notificationsMenu.find('.dropdown-toggle').attr('aria-expanded', 'false');
            }

            // Close categories dropdown if clicking outside
            var categoriesMenu = $('#categoriesDropdown').parent();
            if (categoriesMenu.length && !categoriesMenu[0].contains(e.target)) {
                categoriesMenu.find('.dropdown-menu').removeClass('show');
                categoriesMenu.find('.dropdown-toggle').attr('aria-expanded', 'false');
            }
        });

        $(document).on('keydown.mythemeGlobal', function(e) {
            if (e.key === 'Escape') {
                $('.dropdown-menu.show').removeClass('show');
                $('.dropdown-toggle[aria-expanded="true"]').attr('aria-expanded', 'false');
                $('.dropdown-arrow-icon').css('transform', 'rotate(0deg)');
            }
        });
    }

    // ===== SEARCH MODAL =====
    function initSearchModal() {
        $('#searchButtonDesktop').on('click', function(e) {
            e.preventDefault();
            var modalElement = $('#searchModal');
            if (modalElement.length) {
                try {
                    var modal = new bootstrap.Modal(modalElement[0]);
                    modal.show();
                } catch(e) {
                    // Fallback to direct navigation
                    window.location.href = $(this).attr('href');
                }
            } else {
                // Direct navigation if modal doesn't exist
                window.location.href = $(this).attr('href');
            }
        });
        
        $('#mobileSearchBtn').on('click', function(e) {
            e.preventDefault();
            closeMobileMenu('mobileMenuPanel', 'mobileMenuOverlay');
            var modalElement = $('#searchModal');
            if (modalElement.length) {
                try {
                    var modal = new bootstrap.Modal(modalElement[0]);
                    modal.show();
                } catch(e) {
                    window.location.href = $(this).attr('href');
                }
            } else {
                window.location.href = $(this).attr('href');
            }
        });
    }
    
    // ===== NOTIFICATIONS =====
    
    // Notifications handled by Moodle default behavior via navbar_plugin_output
    
    // Notifications handled by Moodle default behavior
    
    // ===== MOBILE SUBMENU FOR CATEGORIES =====
    function initMobileSubmenu() {
        // Categories link handling - navigate directly without submenu
        $('.mobile-menu-panel .nav-link[href*="course/index.php"]').on('click', function(e) {
            // Let it navigate normally - no submenu needed for categories
            closeMobileMenu('mobileMenuPanel', 'mobileMenuOverlay');
        });
        
        $('#backToMainMenu').on('click', function(e) {
            e.preventDefault();
            $('#mobileSubmenuPanel').fadeOut(100);
            $('#mobileMenuPanel').fadeIn(200);
        });
    }

    // ===== MOBILE MENU FUNCTIONS =====
    function openMobileMenu(panelId, overlayId) {
        $('#' + panelId).fadeIn(200).addClass('open');
        $('#' + overlayId).fadeIn(200).addClass('show');
        $('body').addClass('mobile-menu-open');
    }

    function closeMobileMenu(panelId, overlayId) {
        $('#' + panelId).fadeOut(200).removeClass('open');
        $('#' + overlayId).fadeOut(200).removeClass('show');
        $('body').removeClass('mobile-menu-open');
        $('#mobileSubmenuPanel').fadeOut(100);
    }

    $('#mobileMenuToggle').on('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        openMobileMenu('mobileMenuPanel', 'mobileMenuOverlay');
    });
    
    $('#closeMobileMenu, #mobileMenuOverlay').on('click', function() {
        closeMobileMenu('mobileMenuPanel', 'mobileMenuOverlay');
    });

    $('#mobileMenuToggleGuest').on('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        openMobileMenu('mobileMenuPanelGuest', 'mobileMenuOverlayGuest');
    });
    
    $('#closeMobileMenuGuest, #mobileMenuOverlayGuest').on('click', function() {
        closeMobileMenu('mobileMenuPanelGuest', 'mobileMenuOverlayGuest');
    });

    $('.mobile-menu-panel .nav-link:not(#mobileSearchBtn):not(#mobileNotificationsBtn)').on('click', function() {
        closeMobileMenu('mobileMenuPanel', 'mobileMenuOverlay');
        closeMobileMenu('mobileMenuPanelGuest', 'mobileMenuOverlayGuest');
    });

    $(document).on('keydown', function(e) {
        if (e.key === 'Escape') {
            closeMobileMenu('mobileMenuPanel', 'mobileMenuOverlay');
            closeMobileMenu('mobileMenuPanelGuest', 'mobileMenuOverlayGuest');
            $('#mobileSubmenuPanel').fadeOut(100);
        }
    });

    // ===== ACTIVE LINK HIGHLIGHTING =====
    function setActiveLink() {
        var currentPath = window.location.pathname;
        $('.navbar-nav .nav-link, .mobile-menu-panel .nav-link').removeClass('active');
        
        $('.navbar-nav .nav-link, .mobile-menu-panel .nav-link').each(function() {
            var href = $(this).attr('href');
            if (href && href !== '#' && href !== '{{{ config.wwwroot }}}') {
                if (currentPath === href || (href !== '/' && currentPath.indexOf(href) === 0)) {
                    $(this).addClass('active');
                }
            } else if (href === '{{{ config.wwwroot }}}' && 
                      (currentPath === '/' || currentPath === '' || currentPath.indexOf('/index.php') === 0)) {
                $(this).addClass('active');
            }
        });
    }

    // ===== FIX DESKTOP DROPDOWN =====
    function initDesktopDropdown() {
        var dropdownToggle = document.getElementById('userMenuDropdown');
        if (dropdownToggle) {
            // Remove any existing Bootstrap dropdown instances to prevent conflicts
            $(dropdownToggle).off('click.dropdown mouseenter.dropdown mouseleave.dropdown');
            
            // Ensure dropdown is closed on page load
            var $menu = $(dropdownToggle).parent().find('.dropdown-menu');
            $menu.removeClass('show');
            $(dropdownToggle).attr('aria-expanded', 'false');
            $(dropdownToggle).find('.dropdown-arrow-icon').css('transform', 'rotate(0deg)');
            
            $(dropdownToggle).on('click.dropdown', function(e) {
                e.preventDefault();
                e.stopPropagation();
                var $parent = $(this).parent();
                var $menu = $parent.find('.dropdown-menu');
                var $arrow = $(this).find('.dropdown-arrow-icon');
                
                if ($menu.hasClass('show')) {
                    $menu.removeClass('show');
                    $(this).attr('aria-expanded', 'false');
                    $arrow.css('transform', 'rotate(0deg)');
                } else {
                    $('.dropdown-menu.show').removeClass('show');
                    $('.dropdown-toggle[aria-expanded="true"]').attr('aria-expanded', 'false');
                    $('.dropdown-arrow-icon').css('transform', 'rotate(0deg)');
                    
                    $menu.addClass('show');
                    $(this).attr('aria-expanded', 'true');
                    $arrow.css('transform', 'rotate(180deg)');
                    
                    // High z-index to stay above Moodle content
                    $menu.css('z-index', '9999');
                }
            });

            // Handle clicking outside to close
            $(document).off('click.userMenuClose').on('click.userMenuClose', function(e) {
                if (!$(dropdownToggle).parent().is(e.target) && $(dropdownToggle).parent().has(e.target).length === 0) {
                    var $menu = $(dropdownToggle).parent().find('.dropdown-menu');
                    if ($menu.hasClass('show')) {
                        $menu.removeClass('show');
                        $(dropdownToggle).attr('aria-expanded', 'false');
                        $(dropdownToggle).find('.dropdown-arrow-icon').css('transform', 'rotate(0deg)');
                    }
                }
            });
            
            // Prevent hover from opening dropdown
            $(dropdownToggle).parent().off('mouseenter.dropdown mouseleave.dropdown');
        }
    }

    // ===== CLOSE ALL DROPDOWNS ON PAGE LOAD =====
    function closeAllDropdowns() {
        $('.dropdown-menu').removeClass('show');
        $('.dropdown-toggle').attr('aria-expanded', 'false');
        $('.dropdown-arrow-icon').css('transform', 'rotate(0deg)');
    }
    
    // ===== HANDLE ALL DROPDOWN CLICKS =====
    function initAllDropdowns() {
        // Remove ALL existing event handlers for dropdown toggles
        $('.dropdown-toggle, [data-bs-toggle="dropdown"], [data-toggle="dropdown"]').off('click.dropdown mouseenter.dropdown mouseleave.dropdown hover.dropdown');
        
        // Add click handler to dropdown toggles only
        $('.dropdown-toggle, [data-bs-toggle="dropdown"], [data-toggle="dropdown"]').on('click.dropdown', function(e) {
            e.preventDefault();
            e.stopPropagation();
            
            var $this = $(this);
            var $parent = $this.parent();
            var $menu = $parent.find('.dropdown-menu');
            
            // Close all other dropdowns first
            $('.dropdown-menu').not($menu).removeClass('show');
            $('.dropdown-toggle').not($this).attr('aria-expanded', 'false');
            
            // Toggle current dropdown
            if ($menu.hasClass('show')) {
                $menu.removeClass('show');
                $this.attr('aria-expanded', 'false');
                if ($this.find('.dropdown-arrow-icon').length) {
                    $this.find('.dropdown-arrow-icon').css('transform', 'rotate(0deg)');
                }
            } else {
                $menu.addClass('show');
                $this.attr('aria-expanded', 'true');
                
                // If this is the notifications bell, let Moodle handle it or do nothing extra
                if ($this.attr('id') === 'notificationsBell') {
                    // Moodle default behavior
                }

                // Extra handling for categories dropdown
                if ($this.attr('id') === 'categoriesDropdown') {
                    $menu.addClass('show');
                    $this.attr('aria-expanded', 'true');
                }
                
                if ($this.find('.dropdown-arrow-icon').length) {
                    $this.find('.dropdown-arrow-icon').css('transform', 'rotate(180deg)');
                }
            }
        });
        
        // Prevent hover events on dropdown toggles
        $('.dropdown, .dropdown-toggle, [data-bs-toggle="dropdown"], [data-toggle="dropdown"]').off('mouseenter.dropdown mouseleave.dropdown hover.dropdown');
        $('.dropdown, .dropdown-toggle, [data-bs-toggle="dropdown"], [data-toggle="dropdown"]').on('mouseenter.dropdown mouseleave.dropdown hover.dropdown', function(e) {
            e.preventDefault();
            e.stopPropagation();
            return false;
        });
    }

    // Function to hide edit mode button text globally and handle label clicks
    function initMobileEditModeButton() {
        // Find all edit mode buttons and hide their internal text non-destructively
        setTimeout(function() {
            var editContainers = $('.edit-mode-button-only, .edit-mode-container');
            editContainers.each(function() {
                var $container = $(this);
                
                // Remove text nodes from internal labels to hide "Edit mode" text 
                // while keeping the label element for the switch UI
                $container.find('label').contents().filter(function() {
                    return this.nodeType === 3;
                }).remove();
                
                // Ensure manual spans trigger the input
                $container.find('> span').css('cursor', 'pointer').off('click').on('click', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    var $checkbox = $container.find('input[type="checkbox"]');
                    if ($checkbox.length) {
                        // Directly trigger the click on the checkbox
                        $checkbox[0].click();
                    }
                });
            });
            
            // For instances where Moodle might not have bound the event to the second toggle
            // We can try to sync them if needed, but unique IDs usually solve it.
        }, 300);
    }

    initMobileProfileDropdown();
    initSearchModal();
    initMobileSubmenu();
    initMobileEditModeButton();
    
    // Close all dropdowns on page load
    closeAllDropdowns();
    
    // Initialize all dropdowns
    initAllDropdowns();
    
    // Small delay to ensure DOM is stable on complex pages like courses
    setTimeout(function() {
        initDesktopDropdown();
        initGlobalDropdownClosers();
        closeAllDropdowns(); // Ensure all are closed after init
        initAllDropdowns(); // Re-initialize all dropdowns
        initMobileEditModeButton(); // Re-run for edit mode button
    }, 300);
    setActiveLink();
    
    // Re-initialize dropdowns after page loads to ensure they work properly
    $(document).on('page-loaded', function() {
        setActiveLink();
        initDesktopDropdown();
        initMobileProfileDropdown();
        closeAllDropdowns(); // Ensure all are closed on page load
        initAllDropdowns(); // Re-initialize all dropdowns
        initMobileEditModeButton();
    });
    
    // Also re-initialize on DOM changes for dynamic content
    $(document).ajaxComplete(function() {
        setTimeout(function() {
            initDesktopDropdown();
            initAllDropdowns(); // Re-initialize all dropdowns
            closeAllDropdowns(); // Close any that might have opened
            initMobileEditModeButton();
        }, 100);
    });
    
    // Notification polling removed - handled by Moodle default behavior

});
{{/js}}