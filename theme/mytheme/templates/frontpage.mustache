    <div class="container-fluid p-0">
        <!-- Hero Section -->
        <div class="hero-section" style="position: relative; width: 100%; min-height: 100vh; margin-top: -1px; background: #0a0a2a;">
            <!-- Full Width Background Image -->
            <div style="position: absolute; top: 0; left: 0; right: 0; bottom: 0; z-index: 0;">
                <img src="{{{heroimage}}}" 
                    alt="Professional Learning" 
                    class="hero-bg-image"
                    style="width: 100%; height: 100%; display: block;">
            </div>

            <!-- Dark Overlay for Text Readability -->
            <div style="position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: var(--hero-overlay-color, linear-gradient(135deg, rgba(0,0,0,0.65) 0%, rgba(0,0,0,0.45) 100%)); z-index: 1;"></div>

            <!-- Content -->
            <div class="container" style="position: relative; z-index: 2; max-width: 1200px; margin: 0 auto; padding: 0 15px; height: 100%;">
                <div class="row" style="min-height: 100vh; height: 100%; align-items: center;">
                    <!-- Left Content - 6 Columns -->
                    <div class="col-12 col-lg-6 text-white py-5 text-center text-lg-start"> 
                    <p class="mb-3" style="color: var(--hero-tagline-color, {{secondarycolor}}); font-weight: 600; text-shadow: 1px 1px 2px rgba(0,0,0,0.5);">
                            {{herotagline}}
                    </p>
                        
                        <h1 class="mb-4 fw-bold" style="color: var(--hero-title-color, #ffffff); font-size: 3rem; line-height: 1.2; text-shadow: 2px 2px 4px rgba(0,0,0,0.5);">
                            {{{herotitle}}}
                        </h1>
                        
                        <p class="lead mb-4" style="color: var(--hero-desc-color, #ffffff); font-size: 1.1rem; opacity: 0.95; text-shadow: 1px 1px 2px rgba(0,0,0,0.5);">
                        {{{herodescription}}}
                        </p>
                        
                        <!-- Search Bar with Live Search -->
<div class="mt-4 mb-4 position-relative">
    <div class="responsive-search-form">
        <div class="search-wrapper">
            <div class="search-input-group">
                <input type="text" 
                    class="search-input-field" 
                    id="liveSearchInput"
                    name="search" 
                    placeholder="Search Here..." 
                    autocomplete="off"
                    aria-label="Search courses">
                <button class="search-submit-btn" type="button" id="searchSubmitBtn">
                    <i class="fa fa-arrow-right me-2"></i>Find Courses
                </button>
            </div>
            <!-- Live Search Results Dropdown -->
            <div id="liveSearchResults" class="live-search-results"></div>
        </div>
    </div>
</div>
