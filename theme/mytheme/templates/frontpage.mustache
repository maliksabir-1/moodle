        // Counter animation for stats numbers
        function animateCounter(element, start, end, duration) {
            let startTimestamp = null;
            const step = (timestamp) => {
                if (!startTimestamp) startTimestamp = timestamp;
                const progress = Math.min((timestamp - startTimestamp) / duration, 1);
                element.innerText = Math.floor(progress * (end - start) + start);
                if (progress < 1) {
                    window.requestAnimationFrame(step);
                }
            };
            window.requestAnimationFrame(step);
        }

        // Animate the dynamic stats numbers
        const observerOptions = {
            threshold: 0.3,
            rootMargin: "0px"
        };

        const statsObserver = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    // Find all number elements in the dynamic stats section
                    const statNumbers = document.querySelectorAll('.dynamic-stats-section h3');
                    statNumbers.forEach(stat => {
                        const targetCount = parseInt(stat.innerText);
                        if (targetCount > 0 && !stat.hasAttribute('data-animated')) {
                            stat.setAttribute('data-animated', 'true');
                            // Start from 0 and count up
                            stat.innerText = '0';
                            animateCounter(stat, 0, targetCount, 1500);
                        }
                    });
                    statsObserver.unobserve(entry.target);
                }
            });
        }, observerOptions);

        const dynamicStatsSection = document.querySelector('.dynamic-stats-section');
        if (dynamicStatsSection) {
            statsObserver.observe(dynamicStatsSection);
        }

        // Live Search Functionality
(function() {
    const searchInput = document.getElementById('liveSearchInput');
    const resultsContainer = document.getElementById('liveSearchResults');
    const searchBtn = document.getElementById('searchSubmitBtn');
    let searchTimeout;
    let currentSearchTerm = '';
    let isSearching = false;

    if (!searchInput || !resultsContainer) {
        console.warn('Live search elements not found');
        return;
    }

    // Function to highlight search term
    function highlightText(text, term) {
        if (!text || !term || term.length < 2) return text;
        try {
            const regex = new RegExp(`(${term.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')})`, 'gi');
            return text.replace(regex, '<span class="live-search-highlight">$1</span>');
        } catch (e) {
            return text;
        }
    }

    // Helper function to escape HTML
    function escapeHtml(text) {
        if (!text) return '';
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }

    // Function to perform search
    function performSearch(searchTerm) {
        if (!searchTerm || searchTerm.length < 2) {
            resultsContainer.classList.remove('show');
            resultsContainer.innerHTML = '';
            return;
        }

        if (isSearching) return;
        
        currentSearchTerm = searchTerm;
        isSearching = true;
        
        // Show loading state
        resultsContainer.innerHTML = '<div class="live-search-loading"><i class="fa fa-spinner fa-spin"></i> Searching courses...</div>';
        resultsContainer.classList.add('show');

        const ajaxUrl = '{{{ config.wwwroot }}}/theme/mytheme/ajax_search.php?q=' + encodeURIComponent(searchTerm);
        
        fetch(ajaxUrl, {
            method: 'GET',
            headers: {
                'Accept': 'application/json',
                'X-Requested-With': 'XMLHttpRequest'
            },
            credentials: 'same-origin'
        })
        .then(response => {
            if (!response.ok) {
                throw new Error('HTTP ' + response.status);
            }
            return response.json();
        })
        .then(data => {
            isSearching = false;
            
            // Only update if this is still the current search term
            if (currentSearchTerm !== searchTerm) return;
            
            // Check if data is an array
            if (!data || !Array.isArray(data)) {
                console.warn('Invalid response format:', data);
                resultsContainer.innerHTML = '<div class="live-search-no-results">Unable to load results. Please try again.</div>';
                return;
            }
            
            if (data.length === 0) {
                resultsContainer.innerHTML = '<div class="live-search-no-results">No courses found matching "' + escapeHtml(searchTerm) + '"</div>';
                return;
            }

            // Build results HTML
            let html = '';
            data.forEach(course => {
                if (!course || !course.id) return;
                
                const courseImage = course.image ? 
                    `<img src="${course.image}" class="live-search-item-image" alt="${escapeHtml(course.fullname)}" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">` :
                    `<div class="live-search-item-image d-flex align-items-center justify-content-center bg-primary text-white">
                        <i class="fa fa-book"></i>
                    </div>`;
                
                html += `
                    <a href="${escapeHtml(course.url)}" class="live-search-item" data-course-id="${course.id}">
                        ${courseImage}
                        <div class="live-search-item-content">
                            <div class="live-search-item-title">${highlightText(escapeHtml(course.fullname), searchTerm)}</div>
                            ${course.categoryname ? `<div class="live-search-item-category"><i class="fa fa-folder"></i> ${escapeHtml(course.categoryname)}</div>` : ''}
                            ${course.summary ? `<div class="live-search-item-summary">${highlightText(escapeHtml(course.summary), searchTerm)}</div>` : ''}
                            <div class="live-search-item-meta">
                                <span><i class="fa fa-users"></i> ${course.studentcount || 0} students</span>
                            </div>
                        </div>
                    </a>
                `;
            });
            resultsContainer.innerHTML = html;
        })
        .catch(error => {
            isSearching = false;
            console.error('Search error:', error);
            resultsContainer.innerHTML = '<div class="live-search-no-results">Error loading results. Please check your connection and try again.</div>';
        });
    }

    // Input event with debounce
    let debounceTimeout;
    searchInput.addEventListener('input', function(e) {
        const searchTerm = e.target.value.trim();
        
        clearTimeout(debounceTimeout);
        debounceTimeout = setTimeout(() => {
            performSearch(searchTerm);
        }, 400);
    });

    // Focus event - show results if there's a search term
    searchInput.addEventListener('focus', function() {
        const searchTerm = this.value.trim();
        if (searchTerm.length >= 2 && resultsContainer.innerHTML && resultsContainer.innerHTML !== '' && !resultsContainer.innerHTML.includes('no courses')) {
            resultsContainer.classList.add('show');
        }
    });

    // Click outside to close results
    document.addEventListener('click', function(e) {
        if (searchInput && resultsContainer && 
            !searchInput.contains(e.target) && 
            !resultsContainer.contains(e.target)) {
            resultsContainer.classList.remove('show');
        }
    });

    // Escape key to close results
    searchInput.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
            resultsContainer.classList.remove('show');
            this.blur();
        }
    });

    // Submit on enter key (fallback to normal search)
    searchInput.addEventListener('keypress', function(e) {
        if (e.key === 'Enter') {
            e.preventDefault();
            const searchTerm = this.value.trim();
            if (searchTerm) {
                window.location.href = '{{{ config.wwwroot }}}/course/search.php?search=' + encodeURIComponent(searchTerm);
            }
        }
    });

    // Search button click
    if (searchBtn) {
        searchBtn.addEventListener('click', function(e) {
            e.preventDefault();
            const searchTerm = searchInput.value.trim();
            if (searchTerm) {
                window.location.href = '{{{ config.wwwroot }}}/course/search.php?search=' + encodeURIComponent(searchTerm);
            }
        });
    }

    // Keyboard navigation for results
    let selectedIndex = -1;
    
    searchInput.addEventListener('keydown', function(e) {
        const items = document.querySelectorAll('.live-search-item');
        if (items.length === 0) return;
        
        if (e.key === 'ArrowDown') {
            e.preventDefault();
            selectedIndex = Math.min(selectedIndex + 1, items.length - 1);
            updateSelectedItem(items);
        } else if (e.key === 'ArrowUp') {
            e.preventDefault();
            selectedIndex = Math.max(selectedIndex - 1, -1);
            updateSelectedItem(items);
        } else if (e.key === 'Enter' && selectedIndex >= 0) {
            e.preventDefault();
            const selectedItem = items[selectedIndex];
            if (selectedItem && selectedItem.href) {
                window.location.href = selectedItem.href;
            }
        }
    });
    
    function updateSelectedItem(items) {
        items.forEach((item, index) => {
            if (index === selectedIndex) {
                item.style.backgroundColor = '#f8f9fa';
                item.style.outline = '2px solid var(--primary-color)';
                item.scrollIntoView({ block: 'nearest' });
            } else {
                item.style.backgroundColor = '';
                item.style.outline = '';
            }
        });
    }
    
    // Ctrl+K / Cmd+K shortcut to focus search
    document.addEventListener('keydown', function(e) {
        if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
            e.preventDefault();
            if (searchInput) {
                searchInput.focus();
                searchInput.select();
            }
        }
    });
})();
