        <style>
            /* Hero Background Image - Responsive */
            .hero-bg-image {
                object-fit: cover;
                object-position: center center;
            }
            
            /* Responsive Search Bar Styles */
            .responsive-search-form {
                width: 100%;
                max-width: 500px;
            }
            
            .search-wrapper {
                width: 100%;
            }
            
            .search-input-group {
                display: flex;
                align-items: center;
                background: white;
