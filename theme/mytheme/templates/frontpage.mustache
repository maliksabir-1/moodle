                }

                .search-submit-btn i {
                    display: inline-block;
                    font-size: 0.7rem;
                }
            }
            

            /* Small mobile devices - Even smaller text */
            @media (max-width: 480px) {
                .hero-section {
                    padding-top: 55px !important;
                }
                
                .hero-bg-image {
                    object-position: center 25% !important;
                }
                
                .hero-section .row {
                    padding-top: 20px !important;
                    padding-bottom: 40px !important;
                }

                .hero-section h1 {
                    font-size: 1.3rem !important;
                    margin-bottom: 0.5rem !important;
                }
                
                .hero-section .lead {
                    font-size: 0.8rem !important;
                    margin-bottom: 0.5rem !important;
                }
                
                .hero-section p:first-child {
                    font-size: 0.65rem !important;
                    margin-bottom: 0.3rem !important;
                }

                .search-input-field {
                    height: 36px;
                    font-size: 0.7rem;
                    padding: 0 10px;
                }

                .search-submit-btn {
                    height: 36px;
                    font-size: 0.65rem;
                    padding: 0 8px;
                }
                
                .search-submit-btn i {
                    display: none;
                }
                
                .mt-4 {
                    margin-top: 0.3rem !important;
                }
                
                .mb-4 {
                    margin-bottom: 0.3rem !important;
                }
            }
            
            /* Large Desktop */
            @media (min-width: 1367px) {
                .hero-section {
                    min-height: 90vh !important;
                }
                
                .hero-bg-image {
                    object-fit: cover;
                }
                
                .search-input-field {
                    height: 50px;
                    font-size: 1rem;
                }
                
                .search-submit-btn {
                    height: 50px;
                    font-size: 0.95rem;
                }
            }
