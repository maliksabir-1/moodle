{{> theme_boost/head }}

<body {{{ bodyattributes }}}>
{{> core/local/toast/wrapper}}

<div id="page-wrapper" class="modern-auth-wrapper-centered" style="overflow: hidden;">

    {{{ output.standard_top_of_body_html }}}

    <div class="modern-auth-container-centered" style="overflow: visible;">
       

        <div class="container" style="overflow: visible;">
            <div class="row justify-content-center align-items-center mt-5 mb-5 bg-blue min-vh-100" style="margin: 0; overflow: visible;">
                <!-- Column width controls -->
                <div class="col-12 col-sm-10 col-md-8 col-lg-6 col-xl-5" style="overflow: visible;">
                    <div class="auth-card shadow-lg" style="overflow: visible;">
                        <div class="auth-card-body p-4 p-md-5">
                            <div class="auth-logo-container text-center mb-4">
                                {{#logourl}}
                                    <img src="{{{logourl}}}" class="auth-logo img-fluid" alt="{{sitename}}" style="max-height: 60px; width: auto;"/>
                                {{/logourl}}
                            </div>
                            
                            {{{ output.main_content }}}

                            {{#issignup}}
                                <div class="text-center mt-4 pt-3 border-top">
                                    <p class="mb-0 text-muted">
                                        Already have an account? 
                                        <a href="{{{loginurl}}}" class="fw-bold text-decoration-none" style="color: #1a56db;">Log in</a>
                                    </p>
                                </div>
                            {{/issignup}}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>

<!-- Fixed CSS to remove double scrollbars -->
<style>
/* Remove all overflow that causes double scrollbars */
html, body {
    overflow-x: hidden !important;
    overflow-y: auto !important;
    margin: 0 !important;
    padding: 0 !important;
    height: auto !important;
}
body.pagelayout-login {
    background: royalblue !important;
    min-height: 100vh;
}



/* Ensure login form elements take full width */
.auth-card .loginform {
    width: 100%;
    max-width: 100%;
}

.auth-card .login-form .form-control {
    width: 100% !important;
    min-width: 100%;
}

.auth-card .login-form .btn {
    width: 100%;
}

.auth-card .row {
    margin-left: 0;
    margin-right: 0;
}

.auth-card .col-6 {
    padding-left: 0;
    padding-right: 0;
}

/* Ensure inputs are full width */
.auth-card input.form-control-lg {
    width: 100% !important;
}

/* Make sure the login container doesn't overflow */
.auth-card .login-container,
.auth-card .login-wrapper {
    max-width: 100%;
    overflow-x: hidden;
}

/* Remove any extra scroll from body */
body.pagelayout-login {
    overflow-y: auto !important;
    overflow-x: hidden !important;
}

/* Remove scroll from the main wrapper */
#page,
.drawers,
.main-inner,
#page-content,
#region-main {
    overflow: visible !important;
}

/* Hide redundant large images in the login content */
.auth-card-body img:not(.auth-logo) {
    display: none !important;
}

/* Premium Site Name Styling */
.auth-site-name {
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--primary-color, #1a56db) !important;
    font-size: 1.6rem !important;
    margin-top: 5px;
}

/* Premium Input Styling */
.auth-card .form-control {
    border: 1px solid #e2e8f0 !important;
    border-radius: 12px !important;
    padding: 12px 20px !important;
    transition: all 0.3s ease !important;
    background-color: #f8fafc !important;
}

.auth-card .form-control:focus {
    background-color: #ffffff !important;
    border-color: var(--primary-color, #1a56db) !important;
    box-shadow: 0 0 0 4px rgba(26, 86, 219, 0.1) !important;
}

/* Login Button Polish */
.auth-card .btn-primary {
    border-radius: 12px !important;
    padding: 12px !important;
    font-weight: 600 !important;
    letter-spacing: 0.5px !important;
    transition: all 0.3s ease !important;
}

.auth-card .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(26, 86, 219, 0.25) !important;
}

/* Responsive adjustments for smaller screens */
@media (max-width: 576px) {
    .auth-card-body {
        padding: 1.5rem !important;
    }
    
    .auth-card .row.mt-4 .col-6 {
        padding: 0 8px;
    }
    
    .auth-card .btn-outline-secondary {
        white-space: nowrap;
        font-size: 0.75rem;
    }
}

@media (min-width: 768px) and (max-width: 991px) {
    .auth-card-body {
        padding: 2rem !important;
    }
}

/* Fix for any hidden overflow issues */
* {
    -webkit-overflow-scrolling: touch;
}

/* Ensure modal doesn't cause scroll issues */
.modal {
    overflow-y: auto !important;
}
</style>

{{#js}}
M.util.js_pending('theme_boost/loader');
require(['theme_boost/loader'], function() {
  M.util.js_complete('theme_boost/loader');
});
{{/js}}

</body>
</html>