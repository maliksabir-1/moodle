{{!

    @template theme_boost/navbar

    This template renders the top navbar.

    Example context (json):
    {
        "output": {
            "should_display_navbar_logo": true,
            "get_compact_logo_url": "http://placekitten.com/50/50",
            "custom_menu": "<li>..</li>",
            "page_heading_menu": "<li>..</li>",
            "search_box": "<div><input type='text'></div>",
            "navbar_plugin_output": "<div class='dropdown'>Messaging</div>",
            "user_menu": "<div class='dropdown'>John Doe</div>"
        },
        "config": {
            "wwwroot": "#",
            "homeurl": "/my/"
        },
        "sitename": "Moodle Site",
        "mobileprimarynav": [
            {
                "text": "Dashboard",
                "url": "/my",
                "isactive": true
            },
            {
                "text": "Site home",
                "url": "/",
                "isactive": false
            },
            {
                "text": "My courses",
                "url": "/course",
                "isactive": false
            }
        ]
    }
}}
<nav class="navbar fixed-top bg-body navbar-expand" aria-label="{{#str}}sitemenubar, admin{{/str}}">
    <div class="container-fluid">
        <button class="navbar-toggler aabtn d-block d-md-none px-1 my-1 border-0" data-toggler="drawers" data-action="toggle" data-target="theme_boost-drawers-primary">
            <span class="navbar-toggler-icon"></span>
            <span class="visually-hidden">{{#str}}sidepanel, core{{/str}}</span>
        </button>

        <a href="{{{ config.homeurl }}}" class="navbar-brand d-none d-md-flex align-items-center m-0 me-4 p-0 aabtn">

            {{# output.should_display_navbar_logo }}
                <img src="{{output.get_compact_logo_url}}" class="logo me-1" alt="{{sitename}}">
            {{/ output.should_display_navbar_logo }}
            {{^ output.should_display_navbar_logo }}
                {{{ sitename }}}
            {{/ output.should_display_navbar_logo }}
            
        </a>
        {{#primarymoremenu}}
            <div class="primary-navigation">
                {{> core/moremenu}}
            </div>
        {{/primarymoremenu}}

        {{# output.page_heading_menu}}
            <ul class="navbar-nav d-none d-md-flex my-1 px-1">
                <!-- page_heading_menu -->
                {{{ output.page_heading_menu }}}
            </ul>
        {{/output.page_heading_menu}}

      <div id="usernavigation" class="navbar-nav ms-auto h-100">
  
    {{#langmenu}}
        {{> theme_boost/language_menu }}
        <div class="divider border-start h-75 align-self-center mx-1"></div>
    {{/langmenu}}
    
    <!-- Advanced Analytics Link -->
    <div class="d-flex align-items-stretch">
        <a href="{{{ config.wwwroot }}}/local/advancedanalytics/index.php" class="btn btn-link nav-link py-0 px-2" title="{{#str}}pluginname, local_advancedanalytics{{/str}}">
            <span class="d-none d-md-inline">{{#str}}pluginname, local_advancedanalytics{{/str}}</span>
        </a>
    </div>

    <!-- All courses Link -->
    <div class="d-flex align-items-stretch">
        <a href="{{{ config.wwwroot }}}/course/index.php" class="btn btn-link nav-link py-0 px-2" title="All courses">
            <span class="d-none d-md-inline">All courses</span>
        </a>
        
    </div>

    <!-- Categories Link -->
    <div class="d-flex align-items-stretch">
        <a href="{{{ config.wwwroot }}}/course/index.php" class="btn btn-link nav-link py-0 px-2" title="Course categories">
            <span class="d-none d-md-inline">Categories</span>
        </a>
    </div>
    
    <!-- Search Icon -->
    <div class="d-flex align-items-stretch">
        <a href="{{{ config.wwwroot }}}/search/index.php" class="btn btn-link nav-link py-0 px-2" title="Search">
            <i class="fa fa-search"></i>
        </a>
    </div>
    

    <!-- NOTIFICATION ICON (THIS WAS MISSING) -->
    {{{ output.navbar_plugin_output }}}
    
    {{#user_level}}
    <div class="d-none d-md-flex align-items-center me-2">
        <div class="user-level-badge p-1 px-3 d-flex align-items-center" 
             style="background: linear-gradient(135deg, {{badge_color}} 0%, #333 100%); border-radius: 20px; color: white; box-shadow: 0 2px 5px rgba(0,0,0,0.2); height: 38px;">
            <span class="fw-bold small me-2">{{level_name}}</span>
            {{#badge_url}}
                <img src="{{badge_url}}" alt="{{level_name}}" style="width: 24px; height: 24px; object-fit: contain;">
            {{/badge_url}}
            {{^badge_url}}
                <i class="fa {{fallback_icon}} text-warning" style="font-size: 1.1rem;"></i>
            {{/badge_url}}
        </div>
    </div>
    {{/user_level}}
    
    <div class="d-flex align-items-stretch usermenu-container" data-region="usermenu">
        {{#usermenu}}
            {{> core/user_menu }}
        {{/usermenu}}
    </div>
    {{{ output.edit_switch }}}
</div>
</nav>

{{> theme_boost/primary-drawer-mobile }}